# 复制为 .env 后填写。程序启动时自动读取，已存在的环境变量优先。

# @MechFiBot 的 token。只写在 .env 里
TELEGRAM_BOT_TOKEN=
# USDT 充值：每个用户的专属地址由这两个 xpub 派生。在你自己电脑上运行
#   go run ./cmd/mechwallet init   生成助记词（离线保存，绝不放服务器）
#   go run ./cmd/mechwallet xpub   输出下面两行
# 两个都不填则网页不开放充值，只填一个就只开对应的链
# EVM：Ethereum / BNB Chain / Arbitrum 共用
PAY_XPUB_EVM=
# TRON：USDT TRC20
PAY_XPUB_TRON=

# 收款网络。testnet 只把收款切到测试网（BNB Chain Testnet、Arbitrum Sepolia、Sepolia、TRON Nile），只认测试币；
# 监控和预警仍读主网。测试网数据写进单独的 mechbot-testnet.db，不碰正式数据。上线前删掉这行或改成 mainnet
# NETWORK=testnet
# 可选。测试网收款节点，不填用内置公共节点
# TESTNET_ETH_RPC_URL=
# TESTNET_BSC_RPC_URL=
# TESTNET_ARB_RPC_URL=
# TESTNET_TRON_API_URL=https://nile.trongrid.io

# 网页对外地址，用于推荐链接。本机开发用 Vite 的地址
SITE_URL=http://localhost:5173
# 后端监听地址。上线放在 Nginx/Caddy 后面时保持 127.0.0.1
HTTP_ADDR=127.0.0.1:8080
# 打包后的页面目录
WEB_DIR=../frontend/dist
# 上线走 HTTPS 时改成 true
COOKIE_SECURE=false

# RPC 节点，可用逗号写多个，按顺序优先使用；程序还会自动追加内置的公共备用节点，一个节点挂了自动切下一个
# 例：ETH_RPC_URL=https://你的付费节点,https://ethereum.publicnode.com
ETH_RPC_URL=https://ethereum.publicnode.com
ARB_RPC_URL=https://arb1.arbitrum.io/rpc
OP_RPC_URL=https://optimism.publicnode.com

# 清算地图（ETH）。Aave 借款人名单来自 Etherscan 日志接口，免费 key 在 etherscan.io/myapikey 申请；
# 不填则地图只统计 Morpho。扫描很慢、单独用一组节点，不影响预警；以后买了付费节点填到 LIQMAP_ETH_RPC_URL。
ETHERSCAN_API_KEY=
# LIQMAP_ETH_RPC_URL=
BSC_RPC_URL=https://bsc-rpc.publicnode.com
TRON_API_URL=https://api.trongrid.io
# 可选。TronGrid 免费 key，量大时避免限流
# TRON_API_KEY=

# 可选。服务异常告警发给谁（你自己的 Telegram 数字 ID）：某条链或协议连续失败约 15 分钟、
# 或充值扫描连续失败约 5 分钟时私聊提醒，恢复后再提醒一次。不填则用 TELEGRAM_CHAT_ID，都不填只写日志
# ADMIN_CHAT_ID=

# 可选。数据库为空时导入一次第一阶段的地址
# TELEGRAM_CHAT_ID=
# WATCH_ADDRESS=
# ALERT_THRESHOLD=1.2

# 可选。默认 mechbot.db，默认轮询 5m
# DB_PATH=mechbot.db
# POLL_INTERVAL=5m
