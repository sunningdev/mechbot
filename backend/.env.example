# Copy to .env and fill in. Read automatically on startup; variables already set in the environment win.

# Token for @MechFi_bot. Keep it in .env only
TELEGRAM_BOT_TOKEN=
# Payments: each user's deposit addresses are derived from these two xpubs. On your own computer run
#   go run ./cmd/mechwallet init   to generate the mnemonic (keep it offline, never on the server)
#   go run ./cmd/mechwallet xpub   to print the two lines below
# Leave both empty to disable billing; set only one to enable just those chains
# EVM: shared by Ethereum / BNB Chain / Arbitrum / Base / Optimism
PAY_XPUB_EVM=
# TRON: USDT TRC20
PAY_XPUB_TRON=

# Payment network. testnet switches only payments to testnets (BNB Chain Testnet, Arbitrum Sepolia, Base Sepolia, OP Sepolia, Sepolia, TRON Nile) and accepts test tokens only;
# monitoring and alerts still read mainnet. Testnet data goes to a separate mechbot-testnet.db and never touches real data. Remove this line or set mainnet before going live
# NETWORK=testnet
# Optional. Testnet payment nodes; built-in public nodes are used when empty
# TESTNET_ETH_RPC_URL=
# TESTNET_BSC_RPC_URL=
# TESTNET_ARB_RPC_URL=
# TESTNET_TRON_API_URL=https://nile.trongrid.io

# Public URL of the site, used in referral links. For local development use the Vite address
SITE_URL=http://localhost:5173
# Backend listen address. Keep 127.0.0.1 when running behind Nginx/Caddy
HTTP_ADDR=127.0.0.1:8080
# Directory of the built frontend
WEB_DIR=../frontend/dist
# Set to true when serving over HTTPS
COOKIE_SECURE=false

# RPC nodes. Separate several with commas, tried in order; built-in public fallbacks are appended automatically, so a dead node just moves on to the next
# Example: ETH_RPC_URL=https://your-paid-node,https://ethereum.publicnode.com
ETH_RPC_URL=https://ethereum.publicnode.com
ARB_RPC_URL=https://arb1.arbitrum.io/rpc
BASE_RPC_URL=https://base-rpc.publicnode.com
OP_RPC_URL=https://optimism.publicnode.com

# Liquidation map (ETH). Aave borrowers come from the Etherscan logs API; get a free key at etherscan.io/myapikey.
# Without it the map only counts Morpho. The scan is slow and uses its own nodes, so it never affects alerts; put a paid node in LIQMAP_ETH_RPC_URL later.
ETHERSCAN_API_KEY=
# LIQMAP_ETH_RPC_URL=
BSC_RPC_URL=https://bsc-rpc.publicnode.com
TRON_API_URL=https://api.trongrid.io
# Optional. Free TronGrid key, avoids rate limits at higher volume
# TRON_API_KEY=

# Optional. WalletConnect project ID for "Connect wallet to pay" on the billing page; free at cloud.reown.com, add your domain there.
# Without it only browser-extension wallets (MetaMask, Rabby, ...) work; mobile wallets via QR are unavailable
# WALLETCONNECT_PROJECT_ID=

# Optional. Who gets service alerts (your own numeric Telegram ID): a DM when a chain or protocol keeps failing for about 15 minutes,
# or deposit scanning keeps failing for about 5 minutes, and another when it recovers. Falls back to TELEGRAM_CHAT_ID; with neither, it only logs
# ADMIN_CHAT_ID=

# Optional. Imports the first-stage address once when the database is empty
# TELEGRAM_CHAT_ID=
# WATCH_ADDRESS=
# ALERT_THRESHOLD=1.2

# Optional. Defaults: mechbot.db, poll every 5m
# DB_PATH=mechbot.db
# POLL_INTERVAL=5m
